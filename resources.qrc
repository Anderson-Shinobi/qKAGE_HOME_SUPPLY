    <file alias="piggy_active.svg">assets/icons/piggy_active.svg</file>
    <file alias="investments.svg">assets/icons/investments.svg</file>
    <file alias="investments_active.svg">assets/icons/investments_active.svg</file>
    <file alias="reports.svg">assets/icons/reports.svg</file>
    <file alias="reports_active.svg">assets/icons/reports_active.svg</file>
    <file alias="logs.svg">assets/icons/logs.svg</file>
